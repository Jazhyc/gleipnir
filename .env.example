# API credentials. Copy this file to .env and fill only the values you use.
HF_TOKEN=
WANDB_API_KEY=
OPENROUTER_API_KEY=
LAMBDA_API_KEY=

# Lambda Cloud SSH/campaign settings.
LAMBDA_CAMPAIGN=monitor-foundation
LAMBDA_SSH_KEY_PATH=
LAMBDA_SSH_KEY_NAME=

# Scratch-backed caches (cluster defaults are also set by setup_dev.sh).
HF_HOME=/scratch/s4626451/.huggingface
HF_HUB_CACHE=/scratch/s4626451/.huggingface/hub
HF_DATASETS_CACHE=/scratch/s4626451/.huggingface/datasets
UV_CACHE_DIR=/scratch/s4626451/.cache/uv

# Optional experiment defaults.
WANDB_PROJECT=gleipnir
TOKENIZERS_PARALLELISM=false

